{
    "name": "fluxphp/fluxphp",
    "description": "FluxPHP — Scalable Procedural PHP Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "core/env.php",
            "core/config.php",
            "core/helpers.php",
            "core/logger.php",
            "core/request.php",
            "core/response.php",
            "core/session.php",
            "core/security.php",
            "core/cache.php",
            "core/database.php",
            "core/validation.php",
            "core/mail.php",
            "core/api.php",
            "core/queue.php",
            "core/modules.php",
            "core/middleware.php",
            "core/renderer.php",
            "core/router.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
