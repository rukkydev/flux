# ─────────────────────────────────────────
#  FluxPHP Environment Example
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────

APP_NAME=FluxPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fluxphp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file

LOG_LEVEL=debug

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
