{
    "name": "fluxphp/fluxphp",
    "description": "FluxPHP — Scalable Procedural PHP Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "core/helpers.php",
            "core/env.php",
            "core/config.php",
            "core/request.php",
            "core/response.php",
            "core/logger.php",
            "core/database.php",
            "core/router.php",
            "core/renderer.php",
            "core/middleware.php",
            "core/security.php",
            "core/cache.php",
            "core/session.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": []
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}